    {
      "id": "how-many-solutions",
      "title": "How many solutions?",
      "strand": "af",
      "std": "8.AF.2",
      "concept": "One / none / infinite solutions",
      "quads": [
        {
          "t": "txt",
          "args": [
            "2x + 3 = 2x + 3"
          ]
        },
        {
          "t": "txt",
          "args": [
            "2x + 3 = 2x + 5"
          ]
        },
        {
          "t": "txt",
          "args": [
            "2x + 3 = x + 7"
          ]
        },
        {
          "t": "txt",
          "args": [
            "2x + 3 = 2x + 1"
          ]
        }
      ],
      "lead": "Solve each equation — how many solutions does it have?",
      "args": [
        "True for every x — infinitely many solutions.",
        "No solution (same slope, different constant).",
        "The only one with exactly one solution (x = 4).",
        "No solution — like box B."
      ],
      "prompts": [
        "Sort these into one / none / infinitely many solutions. Which category appears twice?",
        "What in the equation tells you \"no solution\" before you finish solving?"
      ]
    },
