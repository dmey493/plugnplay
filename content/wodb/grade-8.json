    {
      "id": "rational-or-irrational",
      "title": "Rational or irrational?",
      "strand": "ns",
      "std": "8.NS.1",
      "concept": "Rational & irrational numbers",
      "quads": [
        {
          "t": "txt",
          "args": [
            "&radic;16",
            "= 4"
          ]
        },
        {
          "t": "txt",
          "args": [
            "&radic;2",
            "&asymp; 1.4142…"
          ]
        },
        {
          "t": "txt",
          "args": [
            "0.75"
          ]
        },
        {
          "t": "txt",
          "args": [
            {
              "t": "frac",
              "args": [
                2,
                3
              ]
            }
          ]
        }
      ],
      "lead": "Sort these as rational or irrational.",
      "args": [
        "A square root — but it equals 4, so it is rational.",
        "The only irrational number — &radic;2 never terminates or repeats.",
        "The only one written as a decimal (rational, it terminates).",
        "The only one written as a fraction (rational)."
      ],
      "prompts": [
        "Which is irrational? Two boxes are square roots — why is only one irrational?",
        "How can a decimal tell you a number is rational?"
      ]
    },
    {
      "id": "ordering-numbers-near-3",
      "title": "Ordering numbers near 3",
      "strand": "ns",
      "std": "8.NS.2",
      "concept": "Approximating irrationals",
      "quads": [
        {
          "t": "txt",
          "args": [
            "&radic;9",
            "= 3"
          ]
        },
        {
          "t": "txt",
          "args": [
            "&radic;10",
            "&asymp; 3.16"
          ]
        },
        {
          "t": "txt",
          "args": [
            "&pi;",
            "&asymp; 3.14"
          ]
        },
        {
          "t": "txt",
          "args": [
            "3"
          ]
        }
      ],
      "lead": "Estimate and order these values.",
      "args": [
        "A square root that is exactly 3 (rational).",
        "The largest value — &radic;10 &asymp; 3.16, and irrational.",
        "&pi; &asymp; 3.14 — irrational, a little less than &radic;10.",
        "Exactly 3 — the only one written as a plain integer."
      ],
      "prompts": [
        "Order all four from least to greatest. Which two are equal?",
        "Which are irrational? How do you place them on a number line without a calculator?"
      ]
    },
