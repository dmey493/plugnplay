    {
      "skill_id": "6AF2-S1",
      "name": "Determine which value from a list makes a one-step equation true",
      "column": "looking_back",
      "parent_standard": "6.AF.2",
      "prerequisite_skill": {
        "type": "gap",
        "grade": 6,
        "description": "Substitute a value into a one-step equation and verify whether both sides are equal.",
        "check_question": "Does x = 6.2 make the equation 2.45x = 15.19 true? Show how you checked."
      },
      "i_do_script": "When the question gives me one equation and four candidate values, my job is to test each value until I find the one that makes the two sides match. Watch: the equation is 2.45x = 15.19 and the choices are 6.0, 6.02, 6.11, and 6.2. I substitute each into the left side: 2.45 times 6.0 is 14.70, 2.45 times 6.02 is 14.749, 2.45 times 6.11 is about 14.97, and 2.45 times 6.2 is 15.19. Only 6.2 gives me 15.19 on the right side, so the answer is 6.2.",
      "canonical_error": {
        "pattern": "Student stops at the first value that 'looks close' to the right side instead of substituting carefully, especially when decimals are involved.",
        "example": "For 2.45x = 15.19, the student picks x = 6.11 because 2.45 times 6 is roughly 14.7 and 6.11 is the middle choice, instead of computing 2.45 times 6.11 (about 14.97) and rejecting it.",
        "why": "The student is estimating rather than substituting. They never actually multiply each candidate, so they cannot check the equality precisely — the decimal precision is exactly what the spec is testing."
      },
      "redirect_script": {
        "stop": "Wait — did you actually multiply?",
        "prompt": "Pick one choice, write the multiplication out on paper, and compare your result to the right side. If it doesn't match exactly, cross that choice off.",
        "praise": "Good — you tested each value instead of guessing."
      },
      "vocabulary": [
        {
          "term": "Equation",
          "definition": "A statement that two expressions are equal."
        },
        {
          "term": "Solution",
          "definition": "A value of the variable that makes the equation true."
        },
        {
          "term": "Substitute",
          "definition": "Replace the variable with the value you are testing."
        }
      ],
      "next_steps": {
        "if_pass": "6AF2-S2",
        "if_fail": "6AF2-F1"
      },
      "sample_items": [],
      "engine_stems": [
        1
      ]
    },
    {
      "skill_id": "6AF2-S2",
      "name": "Select all equations from a list that have a given solution",
      "column": "looking_back",
      "parent_standard": "6.AF.2",
      "prerequisite_skill": {
        "type": "gap",
        "grade": 6,
        "description": "Substitute one fixed value into many different equations and verify each one.",
        "check_question": "Which of these equations are true when y = 4: y + 3 = 7, 2y = 9, y - 1 = 3?"
      },
      "i_do_script": "Sometimes the question fixes the value and asks me to find every equation it works in. The value stays the same; the equations change. Watch: the value is y = 4, and the choices include y + 3 = 7, 2y = 8, y - 1 = 3, and y divided by 2 equals 3. I plug 4 into each one. 4 + 3 = 7 — true. 2(4) = 8 — true. 4 - 1 = 3 — true. 4 divided by 2 is 2, not 3 — false. So I select the first three.",
      "canonical_error": {
        "pattern": "Student selects only one equation, treating the prompt like a single-answer multiple choice instead of select-all-that-apply, or only checks until they find the first match.",
        "example": "For 'select all equations with solution y = 4,' the student finds y + 3 = 7 is true, bubbles it, and stops without testing 2y = 8 or y - 1 = 3, missing two correct answers.",
        "why": "The student doesn't recognize multi-select format — they read 'select all' as 'pick one.' Or they understand the format but don't have a system for testing every option, so they quit early."
      },
      "redirect_script": {
        "stop": "Pause — how many can you pick?",
        "prompt": "Read the directions again — the word 'all' means you must test every choice. Number the equations 1 through 5 and check off each one as you substitute.",
        "praise": "Yes — you tested every option, not just the first one that worked."
      },
      "vocabulary": [
        {
          "term": "Solution",
          "definition": "A value of the variable that makes the equation true."
        },
        {
          "term": "Multi-select",
          "definition": "A question where more than one answer can be correct — you mark every choice that fits."
        }
      ],
      "next_steps": {
        "if_pass": "6AF2-S3",
        "if_fail": "6AF2-S1"
      },
      "sample_items": [],
      "engine_stems": [
        2
      ]
    },
    {
      "skill_id": "6AF2-S3",
      "name": "Decide Yes or No for each value of a variable in an inequality",
      "column": "on_grade",
      "parent_standard": "6.AF.2",
      "prerequisite_skill": {
        "type": "gap",
        "grade": 6,
        "description": "Read an inequality (using <, >, less-than-or-equal, greater-than-or-equal) and decide whether a given numeric statement is true.",
        "check_question": "Is the statement 4.7 > 5.1 true or false? How do you know?"
      },
      "i_do_script": "An inequality uses <, >, less-than-or-equal, or greater-than-or-equal, and a value of the variable either satisfies the inequality or it doesn't. The table shows several values, and I judge each one with a Yes or No. Watch: the inequality is c < 6.4. I test c = 5.0: 5.0 is less than 6.4, so Yes. I test c = 6.4: 6.4 is not less than 6.4, so No. I test c = 7.1: 7.1 is greater than 6.4, so No. I fill in each row independently — one row's answer doesn't affect the next.",
      "canonical_error": {
        "pattern": "Student treats < and > as if they always mean 'less than' or always mean the same thing, ignoring which side of the symbol the variable is on, or confuses strict < with less-than-or-equal at the boundary value.",
        "example": "For c < 6.4, the student marks c = 6.4 as 'Yes' because 'it's the same number,' missing that strict < excludes equality.",
        "why": "The student has not internalized the strict-vs-inclusive distinction. At the boundary value the symbol matters, and the student doesn't slow down to check."
      },
      "redirect_script": {
        "stop": "Wait — does the symbol allow equal?",
        "prompt": "Point at the symbol. If it's < or >, equal is NOT allowed. If it has a line under it, equal IS allowed. Re-decide that row with the symbol in mind.",
        "praise": "Right — you read the symbol carefully before answering."
      },
      "vocabulary": [
        {
          "term": "Inequality",
          "definition": "A statement that compares two expressions with <, >, less-than-or-equal, or greater-than-or-equal."
        },
        {
          "term": "True",
          "definition": "The comparison is correct after you substitute the value."
        },
        {
          "term": "Strict inequality",
          "definition": "Uses < or > — equal values do NOT make the statement true."
        }
      ],
      "next_steps": {
        "if_pass": "6AF2-S4",
        "if_fail": "6AF2-F1"
      },
      "sample_items": [],
      "engine_stems": [
        3
      ]
    },
    {
      "skill_id": "6AF2-S4",
      "name": "Select all inequalities from a list for which a given number is a solution",
      "column": "on_grade",
      "parent_standard": "6.AF.2",
      "prerequisite_skill": {
        "type": "gap",
        "grade": 6,
        "description": "Substitute one fixed number into multiple inequalities and judge each one.",
        "check_question": "Which of these are true when x = 11: x < 1, x > 10, x > 14?"
