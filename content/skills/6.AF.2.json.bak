    {
      "skill_id": "6AF2-S5",
      "name": "Identify which set of numbers contains only solutions to an inequality",
      "column": "on_grade",
      "parent_standard": "6.AF.2",
      "prerequisite_skill": {
        "type": "gap",
        "grade": 6,
        "description": "Substitute several values into one inequality and judge whether all of them satisfy it.",
        "check_question": "For x < 1/2, are all of {1/6, 2/5, 1/3, 1/2} solutions? Which one is not?"
      },
      "i_do_script": "The question gives one inequality and four candidate sets, each with several numbers inside. The correct set is the one where every single number makes the inequality true — even one bad number disqualifies a set. Watch: the inequality is x < 1/2 and one set is {1/6, 2/5, 1/3, 1/2}. I check 1/6 < 1/2 — true. 2/5 < 1/2 — true. 1/3 < 1/2 — true. 1/2 < 1/2 — false, because 1/2 is not less than itself. So this set is disqualified, even though three of its numbers worked.",
      "canonical_error": {
        "pattern": "Student picks the set that has the most solutions instead of the set where every member is a solution — they treat 'mostly true' as 'true.'",
        "example": "For x < 1/2, the student picks {1/6, 2/5, 1/3, 1/2} because three of four work, missing that 1/2 fails and only the set where all four members are below 1/2 is correct.",
        "why": "The student is using a 'majority rules' heuristic rather than a universal rule. They have not internalized that 'contains only solutions' is a quantifier — every element must satisfy, not just most."
      },
      "redirect_script": {
        "stop": "Stop — even one wrong number disqualifies the set.",
        "prompt": "For each set, draw four boxes and check off each number against the inequality. The first time you get a 'no,' cross out the entire set and move to the next one.",
        "praise": "Yes — you required every number to work, not just most of them."
      },
      "vocabulary": [
        {
          "term": "Set of numbers",
          "definition": "A group of numbers listed inside braces, like {1/6, 2/5, 1/3}."
        },
        {
          "term": "Solution",
          "definition": "A value that makes the inequality true."
        },
        {
          "term": "Only",
          "definition": "In 'contains only solutions,' the word 'only' means every single number must be a solution — no exceptions."
        }
      ],
      "next_steps": {
        "if_pass": "6AF2-S6",
        "if_fail": "6AF2-S3"
      },
      "sample_items": [],
