{
  "standard_code": "6.AF.2",
  "standard_text": "Demonstrate which values from a specified set, if any, make the equation or inequality true. Use substitution to determine whether a given number in a specified set makes an equation or inequality true.",
  "skills": [
    {
      "skill_id": "6AF2-F1",
      "name": "Substitute a value for a variable and check whether the statement is true",
      "column": "foundation",
      "parent_standard": "6.AF.2",
      "prerequisite_skill": {
        "type": "gap",
        "grade": 5,
        "description": "Read =, <, and > as a question (Are the two sides equal? Is the left smaller? Is the left bigger?) and replace a letter in a number sentence with a given value.",
        "check_question": "If x = 3, what number do you write in place of x in the sentence x + 4 = 7? Is the sentence true?"
      },
      "i_do_script": "When I see a letter like x in an equation or inequality, that letter is just a placeholder for a number. To test whether a value works, I cover the letter and write the number in its place, then I read the sentence and ask, 'Is this true?' Watch: the sentence is x + 4 = 7 and someone says x = 3. I write 3 + 4 = 7. I check: 3 + 4 is 7, and 7 equals 7, so the sentence is true. If the sentence had been x + 4 = 9, then 3 + 4 = 7 is not 9, so x = 3 would be false.",
      "canonical_error": {
        "pattern": "Student computes the side with the variable but never checks it against the other side, or treats the equal sign as 'and then write the answer' rather than as a true/false question.",
        "example": "Given x + 4 = 7 and asked whether x = 5 makes it true, the student writes 5 + 4 = 9 and circles 'yes' because they got an answer, not noticing 9 does not equal 7.",
        "why": "The student is still using = the way they did in early arithmetic — as a 'compute now' signal — instead of as a relation that the two sides must satisfy. They never compare back to the right side."
      },
      "redirect_script": {
        "stop": "Hold on — let's check both sides.",
        "prompt": "Cover the letter, write the value in its place, then circle the sign in the middle and ask out loud, 'Is the left side really equal to (or less than, or greater than) the right side?'",
        "praise": "Nice — you tested both sides before deciding."
      },
      "vocabulary": [
        {
          "term": "Equation",
          "definition": "A number sentence that says two things are equal, using the = sign."
        },
        {
          "term": "Inequality",
          "definition": "A number sentence that uses <, >, less-than-or-equal, or greater-than-or-equal to compare two things."
        },
        {
          "term": "Value",
          "definition": "The specific number you put in place of the variable."
        },
        {
          "term": "True",
          "definition": "The sentence is correct after you substitute — both sides match the comparison."
        }
      ],
      "next_steps": {
        "if_pass": "6AF2-S1",
        "if_fail": "Re-teach what =, <, and > are asking before moving on."
      },
      "sample_items": []
    },
    {
      "skill_id": "6AF2-S0",
      "name": "Pick which whole-number value from a list makes a one-step equation true",
      "column": "looking_back",
      "parent_standard": "6.AF.2",
      "prerequisite_skill": {
        "type": "skill",
        "skill_id": "6AF2-F1"
      },
      "i_do_script": "I have an equation and a list of numbers. My job is to find which number makes the equation true. Watch: x + 6 = 14, choices are 6, 7, 8, 9. I do NOT guess. I substitute each one and check. Try 6: 6 + 6 = 12. Is 12 equal to 14? No. Cross it out. Try 7: 7 + 6 = 13. Equal to 14? No. Cross it out. Try 8: 8 + 6 = 14. Equal to 14? YES. That is my answer. I keep substituting until I find the value that makes both sides equal. The equal sign is a question, not a command — both sides have to match.",
      "canonical_error": {
        "pattern": "Student picks the value that 'looks related' to the numbers in the equation instead of substituting each candidate and checking, often grabbing the right-side number itself or the difference of the two visible numbers.",
        "example": "For x + 6 = 14 with choices 6, 7, 8, 9, the student picks 6 because 6 appears in the equation, or picks 14 if it is offered, instead of substituting each choice and computing.",
        "why": "The student sees numbers in the equation and reaches for a surface-level match instead of treating each choice as a hypothesis to test. They have not internalized the substitute-and-check loop as the actual procedure for these items.",
        "redirect_script": {
          "stop": "Stop — you picked a number, but you didn't test it. We have to put it in and see if both sides match.",
          "prompt": "Point at choice A. Write the equation with that number in place of the variable. Compute the left side. Is it equal to the right side? Yes or no? Now do the same for B, C, and D. Whichever one makes both sides match is the answer.",
          "praise": "You substituted every choice and only picked the one where both sides were equal. That's the whole job."
        }
      },
      "redirect_script": {
        "stop": "Stop — you picked a number, but you didn't test it. We have to put it in and see if both sides match.",
        "prompt": "Point at choice A. Write the equation with that number in place of the variable. Compute the left side. Is it equal to the right side? Yes or no? Now do the same for B, C, and D. Whichever one makes both sides match is the answer.",
        "praise": "You substituted every choice and only picked the one where both sides were equal. That's the whole job."
      },
      "vocabulary": [
        {
          "term": "Substitute",
          "definition": "Replace a variable with a number. If x = 8, then x + 6 becomes 8 + 6."
        },
        {
          "term": "Equation",
          "definition": "A math statement saying two sides are equal. The equal sign asks: do these match?"
        },
        {
          "term": "Solution",
          "definition": "The value that makes the equation true. When you substitute it in, both sides match."
        },
        {
          "term": "True / False",
          "definition": "An equation is true when both sides are equal after you substitute. It is false when they are not."
        }
      ],
      "next_steps": {
        "if_pass": "Move to Skill S1: same task with decimal values (engine stem 1). The substitute-and-check loop is the same — only the arithmetic gets harder.",
        "if_fail": "Drop back to Foundation F1: substitute one value into one equation and decide yes/no. Once the student can confidently verify a single value, return here and walk through the four-choice list one candidate at a time."
      },
      "sample_items": [
        {
          "stem": "Which value of x makes the equation x + 5 = 12 true?",
          "answer": "7",
          "choices": [
            "7",
            "5",
            "12",
            "17"
          ],
          "distractor_logic": "5 -- grabs p from the equation; 12 -- grabs q from the equation; 17 -- adds p+q instead of computing q-p"
        },
        {
          "stem": "Which value of x makes the equation 8 + x = 15 true?",
          "answer": "7",
          "choices": [
            "8",
            "15",
            "23",
            "7"
          ],
          "distractor_logic": "8 -- picks p because it appears first; 15 -- picks q from the right side; 23 -- adds p+q instead of subtracting"
        },
        {
          "stem": "Which value of x makes the equation x - 4 = 9 true?",
          "answer": "13",
          "choices": [
            "5",
            "13",
            "4",
            "9"
          ],
          "distractor_logic": "5 -- computes q-p instead of q+p; 4 -- grabs p; 9 -- grabs q"
        },
        {
          "stem": "Which value of x makes the equation 3x = 18 true?",
          "answer": "6",
          "choices": [
            "15",
