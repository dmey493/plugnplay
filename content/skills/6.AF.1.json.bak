{
  "standard_code": "6.AF.1",
  "standard_text": "Define and use multiple variables when writing expressions to represent real-world and other mathematical problems, and evaluate them for given values.",
  "skills": [
    {
      "skill_id": "6AF1-F1",
      "name": "Identify the four basic operations from context",
      "column": "foundation",
      "parent_standard": "6.AF.1",
      "prerequisite_skill": {
        "type": "gap",
        "grade": 3,
        "description": "Understand addition, subtraction, multiplication, and division as actions",
        "check_question": "If you have 3 groups of 4, what operation do you use to find the total?"
      },
      "i_do_script": "There are four operations in math. Addition puts things together — I see words like 'total,' 'altogether,' 'sum,' 'combined.' Subtraction takes things away — 'left over,' 'remaining,' 'difference,' 'fewer.' Multiplication makes equal groups — 'each,' 'every,' 'per,' 'groups of.' Division splits into equal parts — 'shared equally,' 'split,' 'each person gets.' Watch: '12 cookies shared equally among 4 friends' — 'shared equally' tells me to divide. 12 ÷ 4 = 3.",
      "canonical_error": {
        "pattern": "Cannot distinguish between addition and multiplication in context — treats all 'combining' as addition",
        "example": "For '3 bags with 5 apples each,' student adds 3 + 5 = 8 instead of multiplying 3 × 5 = 15",
        "why": "Student sees two numbers and defaults to addition because it's the most familiar operation. They haven't learned to recognize 'each/every/per' as multiplication signals."
      },
      "item_template": "A one-sentence real-world scenario with two numbers. Student identifies which operation (add, subtract, multiply, or divide) to use. MC with 4 choices.",
      "sample_items": [
        {
          "stem": "Liam picked 18 apples and Noah picked 14 apples. What operation do you use to find how many apples they picked altogether?",
          "answer": "Addition",
          "choices": [
            "Addition",
            "Subtraction",
            "Multiplication",
            "Division"
          ],
          "distractor_logic": "Student might subtract because two numbers are present and 14 is less than 18"
        },
        {
          "stem": "A garden has 9 rows of tomato plants with 6 plants in every row. What operation do you use to find how many plants are in the garden?",
          "answer": "Multiplication",
          "choices": [
            "Addition",
            "Subtraction",
            "Multiplication",
            "Division"
          ],
          "distractor_logic": "Student defaults to addition and adds 9 + 6 instead of multiplying because the keyword 'every' is missed"
        },
        {
          "stem": "There are 28 students in a classroom and 19 of them went to lunch. What operation do you use to find how many students are remaining?",
          "answer": "Subtraction",
          "choices": [
            "Addition",
            "Subtraction",
            "Multiplication",
            "Division"
          ],
          "distractor_logic": "Student might add because two numbers are present and addition feels familiar"
        },
        {
          "stem": "A class of 32 students is divided into teams of 8. What operation do you use to find how many teams there are?",
          "answer": "Division",
          "choices": [
            "Addition",
            "Subtraction",
            "Multiplication",
            "Division"
          ],
          "distractor_logic": "Student might subtract 32 - 8 instead of dividing because they default to subtraction when one number is smaller"
        },
        {
          "stem": "The library has 22 fiction books and 17 nonfiction books on a cart. What operation do you use to find the total number of books on the cart?",
          "answer": "Addition",
          "choices": [
            "Addition",
            "Subtraction",
            "Multiplication",
            "Division"
          ],
          "distractor_logic": "Student might multiply because both numbers describe the same kind of object"
        },
        {
          "stem": "A baker has 56 muffins and packs 8 muffins per box. What operation do you use to find how many boxes the baker fills?",
          "answer": "Division",
          "choices": [
            "Addition",
            "Subtraction",
            "Multiplication",
            "Division"
          ],
          "distractor_logic": "Student defaults to addition or subtracts 56 - 8 instead of dividing because the keyword 'per' is missed"
        },
        {
          "stem": "Carlos read 47 pages on Monday and Mia read 35 pages on Monday. What operation do you use to find how many more pages Carlos read than Mia?",
          "answer": "Subtraction",
          "choices": [
            "Addition",
            "Subtraction",
            "Multiplication",
            "Division"
          ],
          "distractor_logic": "Student might add because two numbers are present and addition is the most familiar operation"
        },
        {
          "stem": "A toy store sells action figures in groups of 5, and Priya buys 4 groups. What operation do you use to find how many action figures Priya buys?",
          "answer": "Multiplication",
          "choices": [
            "Addition",
            "Subtraction",
            "Multiplication",
            "Division"
          ],
          "distractor_logic": "Student adds 5 + 4 = 9 instead of multiplying because they treat 'groups of' as combining rather than equal groups"
        },
        {
          "stem": "Aiden has 24 marbles and gives 9 to his sister. What operation do you use to find how many marbles Aiden has left?",
          "answer": "Subtraction",
          "choices": [
            "Addition",
            "Subtraction",
            "Multiplication",
            "Division"
          ],
          "distractor_logic": "Student might add 24 + 9 because they default to addition when two numbers appear together"
        },
        {
          "stem": "A pizza shop cuts each pizza into 8 slices. What operation do you use to find how many slices are in 7 pizzas?",
          "answer": "Multiplication",
          "choices": [
            "Addition",
            "Subtraction",
            "Multiplication",
            "Division"
          ],
          "distractor_logic": "Student adds 8 + 7 instead of multiplying because the keyword 'each' is missed"
        },
        {
          "stem": "Maya saved $63 and her brother saved $48. What operation do you use to find the combined amount they saved?",
          "answer": "Addition",
          "choices": [
            "Addition",
            "Subtraction",
            "Multiplication",
            "Division"
          ],
          "distractor_logic": "Student might subtract because 48 is less than 63 and that pattern feels like 'find the difference'"
        },
        {
          "stem": "A teacher arranges 45 chairs into rows of 9 chairs. What operation do you use to find how many rows there are?",
          "answer": "Division",
          "choices": [
            "Addition",
            "Subtraction",
            "Multiplication",
            "Division"
          ],
          "distractor_logic": "Student might multiply 45 x 9 because they see 'rows of' and treat it as equal groups instead of splitting"
        },
        {
          "stem": "A runner jogged 7 miles on Monday and 5 miles on Tuesday. What operation do you use to find the total distance jogged?",
          "answer": "Addition",
          "choices": [
            "Addition",
            "Subtraction",
            "Multiplication",
            "Division"
          ],
          "distractor_logic": "Student might multiply 7 x 5 because both numbers describe the same activity"
        },
        {
          "stem": "Each soccer team has 11 players, and there are 6 teams in the tournament. What operation do you use to find the total number of players?",
          "answer": "Multiplication",
          "choices": [
            "Addition",
            "Subtraction",
            "Multiplication",
            "Division"
          ],
          "distractor_logic": "Student adds 11 + 6 instead of multiplying because they default to addition when finding a total"
        },
        {
          "stem": "A jar holds 72 jellybeans, and 4 friends share them equally. What operation do you use to find how many jellybeans each friend gets?",
          "answer": "Division",
          "choices": [
            "Addition",
            "Subtraction",
            "Multiplication",
            "Division"
          ],
          "distractor_logic": "Student might subtract 72 - 4 instead of dividing because they miss the phrase 'shared equally'"
        },
        {
          "stem": "There were 50 cupcakes on a tray, and 18 were eaten at the party. What operation do you use to find how many cupcakes are left?",
          "answer": "Subtraction",
          "choices": [
            "Addition",
            "Subtraction",
            "Multiplication",
            "Division"
          ],
          "distractor_logic": "Student might add because two numbers are present and addition is the most familiar default"
        },
        {
          "stem": "A store has 96 batteries packaged into boxes of 12 batteries per box. What operation do you use to find how many boxes there are?",
          "answer": "Division",
          "choices": [
            "Addition",
            "Subtraction",
            "Multiplication",
            "Division"
          ],
          "distractor_logic": "Student multiplies 96 x 12 because the keyword 'per' is misread as a multiplication signal in every context"
        },
        {
          "stem": "Sofia ran 8 laps and Jamal ran 13 laps. What operation do you use to find how many fewer laps Sofia ran than Jamal?",
          "answer": "Subtraction",
          "choices": [
            "Addition",
            "Subtraction",
            "Multiplication",
            "Division"
          ],
          "distractor_logic": "Student adds 8 + 13 because they default to addition without recognizing 'how many fewer' as a subtraction signal"
        },
        {
          "stem": "A bookshelf has 4 shelves, with 15 books on every shelf. What operation do you use to find how many books are on the bookshelf?",
          "answer": "Multiplication",
          "choices": [
            "Addition",
            "Subtraction",
            "Multiplication",
            "Division"
          ],
          "distractor_logic": "Student adds 4 + 15 instead of multiplying because they overlook the keyword 'every'"
        },
        {
          "stem": "A bus had 26 passengers, and 11 more people got on at the next stop. What operation do you use to find how many passengers are on the bus now?",
          "answer": "Addition",
          "choices": [
            "Addition",
            "Subtraction",
            "Multiplication",
            "Division"
          ],
          "distractor_logic": "Student might subtract because they see two numbers and assume one must be taken away from the other"
        }
      ],
      "redirect_script": {
        "stop": "Let's read the problem again and look for the action word.",
        "prompt": "Every word problem has an action hiding in it. Are we putting things together (add), taking away (subtract), making equal groups (multiply), or splitting into equal parts (divide)? Underline the action word in the problem.",
        "praise": "You found the action word and matched it to the right operation. That's the first step in every word problem."
      },
      "worked_example_script": [
        {
          "kind": "say",
          "text": "Watch how I figure out which operation a word problem is asking me to use."
        },
        {
          "kind": "say",
          "text": "The problem is: 'Liam picked 18 apples and Noah picked 14 apples. What operation do you use to find how many apples they picked altogether?'"
        },
        {
          "kind": "show",
          "text": "Underline the action word 'altogether' in the problem."
        },
        {
          "kind": "say",
          "text": "'Altogether' means we are putting things together, and putting things together is addition."
        },
        {
          "kind": "ask",
          "text": "So which operation do we use when we see the word 'altogether'?"
        },
        {
          "kind": "say",
          "text": "Right, addition. So I circle 'Addition' as my answer."
        },
        {
          "kind": "watch",
          "text": "If a student picks Subtraction because 14 is smaller than 18, or Multiplication because two numbers are present, stop and re-read the problem. Point to 'altogether' and remind them the action word tells us we are combining, not taking away or making equal groups."
        }
      ],
