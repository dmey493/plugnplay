    {
      "skill_id": "6AF1-F2",
      "name": "Understand that a letter can stand for a number",
      "column": "foundation",
      "parent_standard": "6.AF.1",
      "prerequisite_skill": {
        "type": "gap",
        "grade": 4,
        "description": "Solve missing-number problems with blanks (e.g., ___ + 5 = 12)",
        "check_question": "What number goes in the blank? ___ + 5 = 12"
      },
      "i_do_script": "In math, we sometimes don't know a number yet. Instead of leaving a blank or drawing a box, we use a letter. Watch: 'I have some apples and I buy 3 more. Now I have 10.' If I call the apples I started with 'n,' then n + 3 = 10. The letter n is holding the place for a number I need to figure out. It's NOT the word 'apples' — it's the NUMBER of apples. I can check: if n = 7, then 7 + 3 = 10. Yes!",
      "canonical_error": {
        "pattern": "Treats the variable as a label or abbreviation for a word, not as a placeholder for a number",
        "example": "Student writes '5a' meaning '5 apples' instead of '5 times a,' or says 'n means nickels' instead of 'n is the number of nickels'",
        "why": "In earlier grades and science, letters ARE labels (m = meters, L = liters). Students carry that habit into algebra where letters represent unknown quantities."
      },
      "item_template": "A sentence using a variable with a given value. Student replaces the letter with the number and computes. Fill-in response. Problems use only addition or subtraction.",
      "sample_items": [
        {
          "stem": "There are k cookies on a plate. If k = 8, how many cookies are on the plate?",
          "answer": "8",
          "choices": null,
          "distractor_logic": "Tests label-confusion: student may think k means 'cookies' rather than the number of cookies"
        },
        {
          "stem": "If a = 4, what is a + 7?",
          "answer": "11",
          "choices": null,
          "distractor_logic": "Common error: writing 'a7' or '47' from concatenating the letter and number"
        },
        {
          "stem": "If t = 5, what is 12 - t?",
          "answer": "7",
          "choices": null,
          "distractor_logic": "Letter on the right of the operator; student may freeze or compute 12 - 'something else'"
        },
        {
          "stem": "Maria has p pencils. If p = 9, how many pencils does Maria have?",
          "answer": "9",
          "choices": null,
          "distractor_logic": "Label-confusion risk: student may answer 'pencils' instead of the number 9"
        },
        {
          "stem": "If b = 3, what is b + 6?",
          "answer": "9",
          "choices": null,
          "distractor_logic": "Common error: '36' from concatenation instead of substituting and adding"
        },
        {
          "stem": "If x = 11, what is x - 4?",
          "answer": "7",
          "choices": null,
          "distractor_logic": "Common error: not substituting the value of x and leaving the answer in terms of the letter"
        },
        {
          "stem": "If n = 8, what is 15 - n?",
          "answer": "7",
          "choices": null,
          "distractor_logic": "Letter on the right of the operator; student may misorder and compute n - 15"
        },
        {
          "stem": "A jar holds y marbles. If y = 14, how many marbles are in the jar?",
          "answer": "14",
          "choices": null,
          "distractor_logic": "Label-confusion risk: student may think y stands for 'marbles' rather than the count"
        },
        {
          "stem": "If m = 6, what is m + 5?",
          "answer": "11",
          "choices": null,
          "distractor_logic": "Common error: writing '65' from concatenating the letter's value and the number instead of adding"
        },
        {
          "stem": "If c = 10, what is the value of c?",
          "answer": "10",
          "choices": null,
          "distractor_logic": "Tests that the student understands the letter simply equals the assigned number"
        },
        {
          "stem": "If g = 2, what is g x 4?",
          "answer": "8",
          "choices": null,
          "distractor_logic": "Student may treat g as a label and answer '24' or freeze at the multiplication symbol"
        },
        {
          "stem": "There are h hats in a box. If h = 12, how many hats are in the box?",
          "answer": "12",
          "choices": null,
          "distractor_logic": "Label-confusion: student may answer 'hats' rather than the number 12"
        },
        {
          "stem": "If r = 9, what is r - 3?",
          "answer": "6",
          "choices": null,
          "distractor_logic": "Common error: not substituting and leaving the answer as 'r - 3' or writing '93'"
        },
        {
          "stem": "If d = 5, what is 8 + d?",
          "answer": "13",
          "choices": null,
          "distractor_logic": "Letter on the right of the operator; student may concatenate as '85' instead of adding"
        },
        {
          "stem": "A garden has f flowers. If f = 20, how many flowers are in the garden?",
          "answer": "20",
          "choices": null,
          "distractor_logic": "Label-confusion: student may say 'flowers' instead of giving the count 20"
        },
        {
          "stem": "If s = 4, what is s + s?",
          "answer": "8",
          "choices": null,
          "distractor_logic": "Student may write 'ss' or '44' instead of substituting and adding the values"
        },
        {
          "stem": "If w = 7, what is 20 - w?",
          "answer": "13",
          "choices": null,
          "distractor_logic": "Letter on the right; student may misorder and compute w - 20 or freeze"
        },
        {
          "stem": "Jamal collected z stickers. If z = 15, how many stickers did Jamal collect?",
          "answer": "15",
          "choices": null,
          "distractor_logic": "Label-confusion: student may answer 'stickers' rather than the number 15"
        },
        {
          "stem": "If e = 3, what is e x 6?",
          "answer": "18",
          "choices": null,
          "distractor_logic": "Student may treat e as a label and write '36' from concatenation rather than multiplying"
        },
        {
          "stem": "If q = 13, what is q + 2?",
          "answer": "15",
          "choices": null,
          "distractor_logic": "Common error: writing '132' from concatenating the value of q with 2 instead of adding"
        }
      ],
      "redirect_script": {
        "stop": "Remember, in math the letter stands for a number, not a word.",
        "prompt": "Think of the letter like a box with a number hiding inside. When I say n = 6, it means the letter n is holding the number 6. Everywhere you see n, put 6 in its place. Try it.",
        "praise": "You replaced the letter with the number and got the right answer. That's called substitution — you'll use it all the time in algebra."
      },
      "worked_example_script": [
        {
          "kind": "say",
          "text": "Watch how I figure out what a letter stands for in a math problem."
        },
        {
          "kind": "say",
          "text": "The problem says: 'There are k cookies on a plate. If k = 8, how many cookies are on the plate?'"
        },
        {
          "kind": "say",
          "text": "The letter k is not the word 'cookies.' It is holding the place for the NUMBER of cookies."
        },
        {
          "kind": "show",
          "text": "Point to k in the problem, then point to '= 8' and say 'k is hiding the number 8.'"
        },
        {
          "kind": "ask",
          "text": "If k stands for 8, how many cookies are on the plate?"
        },
        {
          "kind": "say",
          "text": "Everywhere I see k, I put 8 in its place. So the answer is 8 cookies."
        },
        {
          "kind": "show",
          "text": "Write 8 on the answer line."
        },
        {
          "kind": "watch",
          "text": "If a student answers 'cookies' or 'k cookies,' they are treating the letter as a label instead of a number. Stop and remind them the letter is hiding a number — point to 'k = 8' and have them say '8' out loud."
        }
      ],
      "printable_artifact": {
        "title": "Letter-Stands-for-a-Number Substitution Chart",
        "kind": "chart",
        "instructions": "When the teacher gives you a value for x, fill in each column by replacing x with that number and working it out. Write the number underneath the letter every time.",
        "categories": [
