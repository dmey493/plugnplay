    {
      "skill_id": "6AF1-S3",
      "name": "Write expressions with exponents from verbal phrases",
      "column": "on_grade",
      "parent_standard": "6.AF.1",
      "engine_stems": [
        2
      ],
      "prerequisite_skill": {
        "type": "skill",
        "skill_id": "6AF1-S2"
      },
      "i_do_script": "When I see 'squared' that means the variable is raised to the 2nd power. 'Cubed' means the 3rd power. Watch: 'three times a number squared' means I take the number, square it, then multiply by 3. That's 3n². The 3 is the coefficient and the 2 is the exponent. I do NOT write 3n × 2 or (3n)² — those mean different things.",
      "canonical_error": {
        "pattern": "Writes repeated multiplication instead of exponent notation, or misplaces the coefficient",
        "example": "Student writes 3 × n × n instead of 3n², or writes (3n)² instead of 3n²",
        "why": "Students understand squaring as 'multiply twice' but haven't internalized compact exponent notation, or they don't know where the coefficient goes relative to the exponent."
      },
      "item_template": "A verbal phrase including 'squared,' 'cubed,' or 'to the ___ power' combined with a coefficient. Student writes the expression using exponent notation. EQ response.",
      "sample_items": [
        {
          "stem": "Write an expression for: 'five times a number x, squared'",
          "answer": "5x²",
          "choices": null,
          "distractor_logic": "Common errors: (5x)² (squares everything), 5x·2 (writes ×2 not ²), 5 + x² (wrong operation)"
        },
        {
          "stem": "Write an expression for: 'a number n cubed, minus 4'",
          "answer": "n³ - 4",
          "choices": null,
          "distractor_logic": "Common errors: n·3 - 4 (multiplies by 3), 3n - 4 (coefficient instead of exponent), (n-4)³"
        },
        {
          "stem": "Write an expression for: 'twice the square of a number y'",
          "answer": "2y²",
          "choices": null,
          "distractor_logic": "Common errors: 2y·2, (2y)², 2 + y²"
        }
      ],
      "redirect_script": {
        "stop": "I see you wrote the exponent as multiplication. Let's look at what 'squared' really means.",
        "prompt": "When we say 'n squared,' we mean n × n, which we write as n². The little 2 up top is the exponent — it tells us how many times to multiply. So 3n² means 3 × n × n. Can you rewrite your answer using the exponent?",
        "praise": "You nailed the exponent notation. The coefficient goes in front, and the exponent goes up top on the variable."
      },
      "worked_example_script": [
        {
          "kind": "say",
          "text": "Watch how I turn a verbal phrase into an expression with an exponent."
        },
        {
          "kind": "say",
          "text": "The phrase is: 'five times a number x, squared.'"
        },
        {
          "kind": "say",
          "text": "'Squared' means raised to the 2nd power, so x squared is written x with a little 2 up top: x²."
        },
        {
          "kind": "say",
          "text": "'Five times' that squared number means 5 is the coefficient out in front."
        },
        {
          "kind": "ask",
          "text": "Where does the 5 go, and where does the little 2 go?"
        },
        {
          "kind": "say",
          "text": "The 5 goes in front of the x, and the 2 goes up on top of the x. So the expression is 5x²."
        },
        {
          "kind": "show",
          "text": "Write 5x² in the answer box, with the 2 up top as a small superscript on the x."
        },
        {
          "kind": "watch",
          "text": "If a student writes (5x)² or 5 × x × x or 5x·2, they're squaring the wrong piece or turning the exponent into multiplication. Stop and remind them: the exponent only sits on the variable, and it means multiply x by itself — not multiply by 2."
        }
      ],
      "printable_artifact": {
        "title": "Write expressions with exponents from verbal phrases Reference",
        "kind": "reference_card",
        "instructions": "Keep this nearby. The left side is what you hear or read; the right side is what you write.",
        "items": [
          "n squared  ->  n²",
          "n cubed  ->  n³",
          "the square of x  ->  x²",
          "the cube of x  ->  x³",
          "x to the 4th power  ->  x⁴",
          "5 times a number squared  ->  5n²",
          "5 times y squared  ->  5y²",
          "twice the square of a number  ->  2n²",
          "three times a number cubed  ->  3n³",
          "the sum of n squared and 4  ->  n² + 4",
          "n cubed minus 4  ->  n³ - 4",
          "7 more than x squared  ->  x² + 7",
          "(5n)² means square the whole thing: 5n × 5n  (NOT the same as 5n²)",
          "5n² means square only n: 5 × n × n  (coefficient stays in front)"
