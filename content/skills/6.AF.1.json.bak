    {
      "skill_id": "6AF1-F3",
      "name": "Recall basic multiplication facts fluently",
      "column": "foundation",
      "parent_standard": "6.AF.1",
      "prerequisite_skill": {
        "type": "gap",
        "grade": 3,
        "description": "Multiply single-digit numbers from memory",
        "check_question": "What is 7 × 8?"
      },
      "i_do_script": "When we evaluate expressions like 4n, we need to multiply quickly. If I see 4n and n = 7, I need to know 4 × 7 = 28 right away. I shouldn't have to count on my fingers or draw groups. Let's practice: 6 × 8 = 48. 7 × 9 = 63. 8 × 8 = 64. If these aren't automatic yet, that's okay — but we need to build that speed because every algebra problem uses multiplication.",
      "canonical_error": {
        "pattern": "Cannot recall multiplication facts, causing errors to cascade into every expression evaluation",
        "example": "For 6n when n = 7, student tries to compute 6 × 7 but gets 48 instead of 42 (counts wrong or confuses with 6 × 8)",
        "why": "Multiplication facts weren't automatized in grades 3-4. The student understands WHAT to do but can't execute accurately because the computation itself is unreliable."
      },
      "item_template": "A straight multiplication fact (single digit × single digit). NR (numeric response). No context, no variables — just the fact.",
