    {
      "skill_id": "6AF1-S4",
      "name": "Write expressions from real-world contexts",
      "column": "on_grade",
      "parent_standard": "6.AF.1",
      "engine_stems": [
        3,
        4
      ],
      "prerequisite_skill": {
        "type": "skill",
        "skill_id": "6AF1-S2"
      },
      "i_do_script": "Now instead of a math phrase, I have a real situation. A movie theater charges $12 per ticket plus a $3 service fee. I need to find the key relationship: 'per ticket' means I multiply the price by the number of tickets. The service fee is added once. If t is the number of tickets, the expression is 12t + 3. I look for: what repeats? That's the multiplication part. What's fixed? That's the addition part.",
      "canonical_error": {
        "pattern": "Picks the wrong operation because the context word is ambiguous — e.g., treats a fixed cost as a rate or swaps which quantity is the coefficient vs. the constant",
        "example": "For 'charges $12 per ticket plus $3 fee,' student writes 3t + 12 (swaps the rate and fixed cost) or 12 + 3t (treats the fee as the rate)",
        "why": "Students don't distinguish between the quantity that repeats (rate × variable) and the quantity that's fixed (constant). Both are 'part of the cost' so they guess which is which."
      },
      "item_template": "A real-world context with a fixed amount and a rate (cost per unit, earnings per hour, etc.). Student selects the correct expression from 4 choices. MC. Distractors swap the rate and constant, use wrong operation, or omit a term.",
      "sample_items": [
        {
          "stem": "A gym charges $25 per month plus a one-time $50 registration fee. Which expression represents the total cost for m months?",
          "answer": "25m + 50",
